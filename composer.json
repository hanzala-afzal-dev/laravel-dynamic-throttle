{
    "name": "hanzala-afzal/laravel-dynamic-throttle",
    "description": "Runtime-managed, identity-aware rate limiting for Laravel: change limits without a deploy, per user or token, and dry-run them first.",
    "keywords": [
        "laravel",
        "rate-limit",
        "rate-limiting",
        "rate-limiter",
        "throttle",
        "throttling",
        "middleware",
        "dry-run"
    ],
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/hanzala-afzal-dev/laravel-dynamic-throttle",
    "support": {
        "issues": "https://github.com/hanzala-afzal-dev/laravel-dynamic-throttle/issues",
        "source": "https://github.com/hanzala-afzal-dev/laravel-dynamic-throttle",
        "security": "https://github.com/hanzala-afzal-dev/laravel-dynamic-throttle/security/policy"
    },
    "authors": [
        {
            "name": "Hanzala Afzal",
            "homepage": "https://github.com/hanzala-afzal-dev",
            "role": "Maintainer"
        }
    ],
    "require": {
        "php": "^8.3",
        "laravel/framework": "^12.0 || ^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.9",
        "laravel/pint": "^1.24",
        "orchestra/testbench": "^10.6 || ^11.0",
        "pestphp/pest": "^4.1 || ^5.0",
        "pestphp/pest-plugin-laravel": "^4.0 || ^5.0",
        "predis/predis": "^2.3 || ^3.0",
        "rector/rector": "^2.1"
    },
    "suggest": {
        "ext-redis": "Needed by the redis driver when you use the phpredis client.",
        "predis/predis": "Needed by the redis driver when you use the predis client instead of ext-redis.",
        "ext-apcu": "Enables the per-server L1 rule cache on PHP-FPM (see docs/adr/0007)."
    },
    "autoload": {
        "psr-4": {
            "Afzal\\DynamicThrottle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Afzal\\DynamicThrottle\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/",
            "Workbench\\Database\\Factories\\": "workbench/database/factories/",
            "Workbench\\Database\\Seeders\\": "workbench/database/seeders/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "@clear",
            "@prepare"
        ],
        "clear": "@php vendor/bin/testbench package:purge-skeleton --ansi",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "build": "@php vendor/bin/testbench workbench:build --ansi",
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "@build",
            "@php vendor/bin/testbench serve --ansi"
        ],
        "test": "@php vendor/bin/pest --exclude-group=drivers",
        "test:drivers": "@php vendor/bin/pest --group=drivers",
        "test:coverage": "@php vendor/bin/pest --exclude-group=drivers --coverage",
        "analyse": "@php vendor/bin/phpstan analyse --memory-limit=1G",
        "format": "@php vendor/bin/pint",
        "format:check": "@php vendor/bin/pint --test",
        "refactor": "@php vendor/bin/rector",
        "refactor:check": "@php vendor/bin/rector --dry-run"
    },
    "scripts-descriptions": {
        "test": "Run the test suite (without the driver suite, which needs docker compose services).",
        "test:drivers": "Run the driver suite against the services from docker-compose.yml.",
        "test:coverage": "Run the test suite with code coverage.",
        "analyse": "Run static analysis (Larastan).",
        "format": "Fix code style (Pint).",
        "format:check": "Check code style without changing files.",
        "refactor": "Apply automated refactorings (Rector).",
        "refactor:check": "Show automated refactorings without applying them."
    },
    "extra": {
        "laravel": {
            "providers": [
                "Afzal\\DynamicThrottle\\DynamicThrottleServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "preferred-install": "dist",
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
