{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/scripts/cloud-session-start.sh\"",
            "timeout": 600,
            "statusMessage": "Preparing the cloud session (PHP extensions, Composer, services)"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/verify.sh\"",
            "timeout": 600,
            "statusMessage": "Running composer test and composer analyse (ADR-0003)"
          }
        ]
      }
    ]
  }
}
