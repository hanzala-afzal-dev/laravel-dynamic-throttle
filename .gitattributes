# Normalize line endings: LF in the repository and in every working tree.
# Shell scripts and PHP files must stay LF to run inside Linux containers.
* text=auto eol=lf

*.png binary
*.gif binary
*.jpg binary
*.ico binary
*.zip binary

# Files and folders left out of the Composer dist archive.
# Users only receive the package code, its config, migrations, views and assets.
/.claude export-ignore
/.github export-ignore
/art export-ignore
/benchmarks export-ignore
/docker export-ignore
/docs export-ignore
/scripts export-ignore
/tests export-ignore
/workbench export-ignore
/.editorconfig export-ignore
/.gitattributes export-ignore
/.gitignore export-ignore
/CLAUDE.md export-ignore
/CODE_OF_CONDUCT.md export-ignore
/CONTRIBUTING.md export-ignore
/docker-compose.yml export-ignore
/phpbench.json export-ignore
/phpstan.neon.dist export-ignore
/phpunit.xml.dist export-ignore
/pint.json export-ignore
/rector.php export-ignore
/testbench.yaml export-ignore

# The dashboard's sources and toolchain (ADR-0028): users get dist/ only.
/resources/dashboard export-ignore
/package.json export-ignore
/package-lock.json export-ignore
/vite.config.ts export-ignore
/tsconfig.json export-ignore
/eslint.config.js export-ignore

# The dashboard's browser tests (SPEC-032).
/e2e export-ignore
/playwright.config.ts export-ignore
/components.json export-ignore
/.nvmrc export-ignore

# The build is generated: diffs and merges take it whole, and it is never edited by hand.
/dist/** -diff linguist-generated=true

