# Normalize line endings: LF in the repository and in every working tree.
# Shell scripts and PHP files must stay LF to run inside Linux containers.
* text=auto eol=lf

*.png binary
*.jpg binary
*.ico binary
*.zip binary

# Files and folders left out of the Composer dist archive.
# Users only receive the package code, its config, migrations, views and assets.
/.claude export-ignore
/.github export-ignore
/docker export-ignore
/docs export-ignore
/scripts export-ignore
/tests export-ignore
/workbench export-ignore
/.editorconfig export-ignore
/.gitattributes export-ignore
/.gitignore export-ignore
/CLAUDE.md export-ignore
/CODE_OF_CONDUCT.md export-ignore
/CONTRIBUTING.md export-ignore
/docker-compose.yml export-ignore
/phpstan.neon.dist export-ignore
/phpunit.xml.dist export-ignore
/pint.json export-ignore
/rector.php export-ignore
/testbench.yaml export-ignore
